# ---------------------------------------------------------------------------
# Poudlard TV — what must never enter the public repository
# ---------------------------------------------------------------------------

# Official app logos (trademarks), a private file rebuilt with
# tools/logos-build.mjs. The repository provides app/assets/logos.example.js.
app/assets/logos.js
/logos.js

# Background music: personal file, never distributed (docs/MUSIC.md).
# The whole folder is ignored, including any license note you might put there.
app/assets/music/*
!app/assets/music/.gitkeep

# Fonts embedded in the APK (OFL): add them with their license if you
# version them; ignored by default to keep the repository light.
app/assets/fonts/

# Hosting page for the mock-up (an index.html variant for publishing as an
# artifact): a working file, not a launcher page.
app/artifact.html

# Android port (android/, no Gradle): build.sh outputs, packages, keys.
android/out/
android/*.keystore
android/*.jks
*.apk
*.aab

# Scenery generation scripts tied to the original workstation (local paths):
# the method is described in tools/README.md, the scripts stay private.
tools/*.ps1

# Working folders (intermediate renders, raw images, discarded screens).
_ecarte/
outputs/
output/
rig/

# System and editors.
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
.vscode/
.idea/
node_modules/

# Local configuration of the Claude app (launching the mock-up server)
.claude/
