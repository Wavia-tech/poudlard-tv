<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen, no title bar, night background (#070B14, the "night" token of base.css) so no white ever shows
         while the WebView loads. System theme without AppCompat: no library. -->
    <style name="PoudlardTV" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
