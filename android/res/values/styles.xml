<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plein écran, sans barre de titre, fond nuit (#070B14, le jeton « night » de base.css) pour ne jamais voir de blanc
         pendant que la WebView charge. Thème système sans AppCompat : aucune bibliothèque. -->
    <style name="PoudlardTV" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
